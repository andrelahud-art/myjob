// FixMyJob.mx - Complete Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  TOURIST
  WORKER
  ADMIN
}

enum JobStatus {
  DRAFT
  PENDING_MATCHING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELED
  DISPUTED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  INTENT_SUCCEEDED
  ESCROW_HELD
  TRANSFERRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DisputeStatus {
  OPEN
  EVIDENCE
  REVIEW
  RESOLVED
  REJECTED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MsgType {
  TEXT
  IMAGE
  SYSTEM
}

// ============================================
// USER MODELS
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String?
  role         UserRole @default(TOURIST)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  profile         Profile?
  worker          WorkerProfile?
  tourist         TouristProfile?
  accounts        OAuthAccount[]
  verifications   Verification[]
  paymentAccounts PaymentAccount[]
  notifications   Notification[]
  reviewsGiven    Review[]         @relation("reviews_given")
  reviewsRecv     Review[]         @relation("reviews_recv")
  messages        Message[]
  auditLogs       AuditLog[]
  jobsAsTourist   Job[]            @relation("job_tourist")
  jobsAsWorker    Job[]            @relation("job_worker")
  bids            Bid[]
  paymentsAsTourist Payment[]      @relation("payment_tourist")
  paymentsAsWorker  Payment[]      @relation("payment_worker")

  @@index([email])
  @@index([role])
}

model Profile {
  id           String  @id @default(cuid())
  userId       String  @unique
  fullName     String
  avatarUrl    String?
  languages    String[] // ["es","en","fr"]
  rating       Float    @default(0)
  ratingsCount Int      @default(0)
  bio          String?
  country      String?
  city         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TouristProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  homeCountry String?
  prefPayment String? // card, link

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkerProfile {
  id            String             @id @default(cuid())
  userId        String             @unique
  headline      String?
  skills        String[] // ["guide","driver","porter","translator"]
  categories    String[] // taxonomy
  baseCity      String?
  radiusKm      Int                @default(15)
  hourlyMinMXN  Int                @default(120)
  availability  Json? // weekly schedule
  kycStatus     VerificationStatus @default(UNVERIFIED)
  lat           Float?
  lng           Float?

  // Relations
  vehicle Vehicle?
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([baseCity])
  @@index([kycStatus])
}

model Vehicle {
  id       String  @id @default(cuid())
  workerId String  @unique
  type     String // car, van
  seats    Int
  plates   String?
  year     Int?
  verified Boolean @default(false)

  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

model OAuthAccount {
  id           String @id @default(cuid())
  userId       String
  provider     String // google, apple
  providerAccountId String
  accessToken  String?
  refreshToken String?
  expiresAt    Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Verification {
  id        String             @id @default(cuid())
  userId    String
  type      String // INE,PASSPORT,DRIVER_LICENSE,PROOF_OF_ADDRESS
  status    VerificationStatus @default(PENDING)
  provider  String? // Incode/Jumio
  fileUrl   String?
  reason    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ============================================
// JOB & SERVICE MODELS
// ============================================

model ServiceCategory {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  icon   String?
  active Boolean @default(true)

  jobs Job[]

  @@index([slug])
  @@index([active])
}

model Job {
  id          String    @id @default(cuid())
  code        String    @unique // human code
  touristId   String
  workerId    String?
  categoryId  String
  title       String
  description String
  languages   String[]
  address     String
  lat         Float
  lng         Float
  city        String
  startAt     DateTime
  endAt       DateTime
  priceMXN    Int // fixed or suggested for hourly
  isHourly    Boolean   @default(false)
  status      JobStatus @default(PENDING_MATCHING)
  paymentId   String?
  escrowId    String?
  checkInOTP  String?
  checkOutOTP String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tourist  User            @relation("job_tourist", fields: [touristId], references: [id])
  worker   User?           @relation("job_worker", fields: [workerId], references: [id])
  category ServiceCategory @relation(fields: [categoryId], references: [id])
  bids     Bid[]
  payments Payment[]
  messages Message[]
  reviews  Review[]
  dispute  Dispute?

  @@index([city, startAt, status])
  @@index([status])
  @@index([touristId])
  @@index([workerId])
  @@index([code])
}

model Bid {
  id        String   @id @default(cuid())
  jobId     String
  workerId  String
  amountMXN Int
  note      String?
  createdAt DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
  @@index([jobId])
}

// ============================================
// PAYMENT MODELS
// ============================================

model Payment {
  id         String        @id @default(cuid())
  jobId      String
  touristId  String
  workerId   String?
  provider   String // stripe
  intentId   String?
  chargeId   String?
  transferId String?
  amountMXN  Int
  currency   String        @default("mxn")
  status     PaymentStatus @default(REQUIRES_PAYMENT)
  feeMXN     Int           @default(0)
  tipMXN     Int           @default(0)
  createdAt  DateTime      @default(now())

  job     Job   @relation(fields: [jobId], references: [id])
  tourist User  @relation("payment_tourist", fields: [touristId], references: [id])
  worker  User? @relation("payment_worker", fields: [workerId], references: [id])

  @@index([status, createdAt])
  @@index([jobId])
}

model PaymentAccount {
  id             String   @id @default(cuid())
  userId         String
  provider       String // stripe
  accountId      String // acct_xxx
  payoutsEnabled Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// REVIEW & REPUTATION
// ============================================

model Review {
  id         String   @id @default(cuid())
  jobId      String
  fromUserId String
  toUserId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  job      Job  @relation(fields: [jobId], references: [id])
  fromUser User @relation("reviews_given", fields: [fromUserId], references: [id])
  toUser   User @relation("reviews_recv", fields: [toUserId], references: [id])

  @@index([toUserId])
  @@index([jobId])
}

// ============================================
// CHAT & MESSAGING
// ============================================

model Message {
  id        String   @id @default(cuid())
  jobId     String
  senderId  String
  type      MsgType  @default(TEXT)
  body      String
  createdAt DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])

  @@index([jobId, createdAt])
}

// ============================================
// DISPUTE MODELS
// ============================================

model Dispute {
  id         String        @id @default(cuid())
  jobId      String        @unique
  openedById String
  status     DisputeStatus @default(OPEN)
  reason     String
  evidence   Json?
  resolution String?
  createdAt  DateTime      @default(now())

  job Job @relation(fields: [jobId], references: [id])

  @@index([status])
}

// ============================================
// SYSTEM MODELS
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
